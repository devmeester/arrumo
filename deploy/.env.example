# Copy to .env and fill in. NEVER commit .env to Git. Permissions: chmod 600 .env

# Domain pointing at the server's IP (DNS A record)
DOMAIN=arrumo.example.com

# Generate with: openssl rand -hex 24
DB_PASSWORD=

# Key that encrypts 2FA secrets and stored settings. Generate with: openssl rand -base64 32
# Keep a copy in a password manager: without it everyone has to set up 2FA again.
APP_ENCRYPTION_KEY=

# Admin created on the first start. After the first login, delete the password line.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# Roles that must use 2FA (ADMIN, MANAGER, OPERATOR, VIEWER, LOGISTICS)
APP_MFA_REQUIRED=ADMIN,MANAGER

# Packing board (admin only): URLs of the 2 Power Automate flows, in single quotes.
# They can also be pasted in the app (Embalamentos > Configurar envios). Empty = the board works but sends nothing.
APP_PACKING_WEBHOOK_DAILY=''
APP_PACKING_WEBHOOK_FINISHED=''
# Time of the daily list (seconds minutes hours day month weekday), Lisbon time
APP_PACKING_CRON=0 0 17 * * MON-FRI
